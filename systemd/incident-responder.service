[Unit]
Description=Suricata Autonomous Incident Responder
After=network.target suricata-alerter.service

[Service]
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=/home/rosee/repos/homelab-siem/.env
ExecStart=/home/rosee/repos/homelab-siem/scripts/.venv/bin/python3 /home/rosee/repos/homelab-siem/scripts/incident_responder.py
Restart=on-failure
RestartSec=10
User=rosee

[Install]
WantedBy=multi-user.target
