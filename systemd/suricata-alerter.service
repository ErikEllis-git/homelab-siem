[Unit]
Description=Suricata IDS Telegram Alerter
After=network.target suricata.service

[Service]
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/rosee/repos/homelab-siem/scripts/.venv/bin/python3 /home/rosee/repos/homelab-siem/scripts/suricata_alerter.py
Restart=on-failure
RestartSec=10
User=rosee

[Install]
WantedBy=multi-user.target
